# Copy this file to .env and fill in your values
# Never commit the real .env file to version control

# LLM API key (required)
LLM_API_KEY=your_api_key_here

# Optional overrides (defaults are in configs/default.yaml)
# TEXTBOOK_MODEL=deepseek-chat
# TEXTBOOK_BASE_URL=https://api.deepseek.com
# TEXTBOOK_OUTPUT_DIR=output

# Streaming output (true = stream tokens to terminal; false = spinner)
# TEXTBOOK_STREAMING=true

# Proxy settings
# TEXTBOOK_PROXY=http://127.0.0.1:7890
# TEXTBOOK_NO_PROXY=false
